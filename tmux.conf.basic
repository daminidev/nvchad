set -s set-clipboard on
set -g mode-keys vi

bind -n F2 previous-window
bind -n F3 next-window
bind -n F4 last-window
bind -n F5 source-file ~/.tmux.conf \; display "Config Reloaded from ~/.tmux.conf"

set -g set-titles on
set -g set-titles-string "#h ❐ #S ● #I #W"

# Status bar
set -g status-left "#[bg=blue,fg=black]   #S #[bg=default,fg=blue] "
set -g status-right "#[bg=default,fg=blue]#[bg=blue,fg=black] #h "

# Set the background of the entire status bar (colour_1)
set -g status-style "bg=#080808"

# --- Inactive Windows ---
set -g window-status-style "fg=#8a8a8a,bg=#080808,none"
set -g window-status-format " #I #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,!,}#{?window_zoomed_flag,Z,} "

# --- Active Window ---
set -g window-status-current-style "fg=#080808,bg=#cf005f,bold"
set -g window-status-current-format " #I #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,!,}#{?window_zoomed_flag,Z,} "

# --- Window with a Bell (Alert) ---
set -g window-status-bell-style "fg=#080808,bg=#a70000,bold"

